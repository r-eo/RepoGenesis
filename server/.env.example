# Production Environment Variables for Render

# Flask Configuration
SECRET_KEY=your-production-secret-key-change-this-to-random-string
DEBUG=False
FLASK_ENV=production

# Database (Render will provide this if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS (Optional - if you want to restrict origins)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
