# Example Production Environment Variables for Vercel

# API URL - Update this to your Render backend URL
REACT_APP_API_URL=https://your-backend.onrender.com/api

# Instructions:
# 1. Copy this file to .env.production
# 2. Update REACT_APP_API_URL with your actual Render URL
# 3. Deploy to Vercel - it will automatically use .env.production
